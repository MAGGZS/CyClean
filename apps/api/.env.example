# Copie para .env (apenas para desenvolvimento local) e preencha.
# Em produção, configure estas variáveis no painel do Render. Nunca faça commit de valores reais.

# String de conexão do pooler do Supabase (Supavisor, modo session, porta 5432).
# Supabase > Project Settings > Database > Connection string > Session pooler
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres

# 32 bytes em base64 para AES-256-GCM. Gere com: pnpm gen-key
ENCRYPTION_KEY=

# Segredo para assinar o cookie de sessão (mínimo 32 caracteres aleatórios). Pode usar: pnpm gen-key
SESSION_SECRET=

# Usuário único do painel.
ADMIN_USER=

# Hash argon2id da senha. Gere com: pnpm hash-password "sua senha"
ADMIN_PASSWORD_HASH=

# Nome da rota do painel no front-end, sem barra (deve ser igual à pasta em apps/web/app).
ADMIN_ROUTE=painel-x7

# Domínio da Vercel que pode chamar esta API (sem barra no final).
ALLOWED_ORIGIN=http://localhost:3000

# Chave da IA padrão (opcional se configurada pelo painel admin)
# Groq é 100% gratuita em https://console.groq.com/keys
GROQ_API_KEY=

# Opcionais
PORT=4000
NODE_ENV=development
